# GCP project + region
GOOGLE_CLOUD_PROJECT=nisse2050
GOOGLE_CLOUD_REGION=us-central1

# Pulumi state bucket + passphrase
PULUMI_STATE_BUCKET=nisse2050-pulumi
PULUMI_CONFIG_PASSPHRASE=

# Telegram bot token (talk to @BotFather to create one).
# In Cloud Run this is injected from Secret Manager — see infrastructure/services/cloud_run_backend.py
TELEGRAM_TOKEN=

# Public webhook URL — only used when running with --cloud (webhook mode).
# Set by Pulumi to the Cloud Run service URL.
WEBHOOK_URL=

# --- LLM agent (baski.agents) ---
# Anthropic API key for the Claude agent loop.
ANTHROPIC_API_KEY=

# MongoDB connection string — MUST include the default database name (the agent
# writes a summary to the `traces` collection on every call).
MONGODB_URI=

# GCS bucket for full agent traces (gzipped JSON under traces/<uuid>.json.gz).
PRIVATE_BUCKET_NAME=

# SerpAPI key — read at SerpApiClient construction (google_search tool).
SERPAPI_API_KEY=
